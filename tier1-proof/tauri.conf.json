{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tier1 Proof",
  "version": "0.1.0",
  "identifier": "com.computedriven.tier1.proof",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Tier 1 proof — the road",
        "width": 1000,
        "height": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:"
    }
  },
  "bundle": { "active": false, "targets": [] }
}
