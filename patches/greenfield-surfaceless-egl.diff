@@ -692,6 +692,58 @@ open_render_node(int drm_fd) {
     return render_fd;
 }
 
+#ifndef EGL_PLATFORM_SURFACELESS_MESA
+#define EGL_PLATFORM_SURFACELESS_MESA 0x31DD
+#endif
+
+static inline int
+westfield_egl_egl_create_surfaceless(struct westfield_egl *westfield_egl) {
+    if (egl_create(westfield_egl)) {
+        wfl_log(stderr, "Failed to create EGL context");
+        return -1;
+    }
+
+    /*
+     * No device and no GBM. Mesa's surfaceless platform builds a display out of
+     * nothing and falls to llvmpipe when there is no hardware behind it -- which
+     * is the only EGL a virtual machine without a DRM node can have, and a
+     * FreeBSD guest cannot be given one (drm-kmod has amdgpu, i915 and radeon;
+     * no virtio-gpu, no vgem, no vkms).
+     */
+    if (egl_init(westfield_egl, EGL_PLATFORM_SURFACELESS_MESA, EGL_DEFAULT_DISPLAY)) {
+        wfl_log(stdout, "Using EGL_PLATFORM_SURFACELESS_MESA (software rendering)");
+        /*
+         * egl_init always records the display's EGL_DEVICE_EXT, and here that is
+         * the SOFTWARE device -- but the display was built by the surfaceless
+         * platform, not the device platform.
+         *
+         * The only reader is gst_frame_encoder_ensure_gst_gl_setup, and a
+         * non-NULL device sends it down
+         * gst_gl_display_egl_device_new_with_egl_device(), which builds a SECOND,
+         * separate EGLDisplay from that device and then tries to create a context
+         * sharing ours. Two displays cannot share a context: eglQueryContext
+         * answers EGL_NOT_INITIALIZED, eglCreateContext answers EGL_BAD_CONTEXT
+         * ten times over, and gst_gl_display_create_context calls g_error --
+         * which is fatal, so the session dies on SIGTRAP the moment a browser
+         * attaches and the first surface needs encoding.
+         *
+         * Report no device and the encoder takes the other branch, wrapping the
+         * display we already initialised. That is the one it can actually share.
+         */
+        westfield_egl->egl.device = EGL_NO_DEVICE_EXT;
+        return 0;
+    }
+
+    wfl_log(stderr, "Failed to initialize surfaceless EGL context");
+    if (westfield_egl->egl.egl_display) {
+        eglMakeCurrent(westfield_egl->egl.egl_display, EGL_NO_SURFACE, EGL_NO_SURFACE,
+                       EGL_NO_CONTEXT);
+        eglTerminate(westfield_egl->egl.egl_display);
+    }
+    eglReleaseThread();
+    return -1;
+}
