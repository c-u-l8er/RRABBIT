+type ProcInfo = { ppid: number; name: string }
+
+/**
+ * A connecting client is matched to the app that launched it by walking up its
+ * parent pids, and Linux keeps both the parent and the name in
+ * `/proc/<pid>/status`.
+ *
+ * FreeBSD does not. procfs is not mounted by default there, and where it is,
+ * `/proc/<pid>/status` is a single space-separated line in an entirely
+ * different format -- so the readFileSync threw ENOENT out of the wl_display
+ * fd callback, which is a native callback: the exception went nowhere, stayed
+ * pending on the napi env, and every later callback failed with
+ * `napi_pending_exception`. One unreadable file and the compositor went deaf
+ * on the FIRST client to connect, silently.
+ *
+ * ps(1) reports both fields, is POSIX, and costs one fork per client
+ * connection -- which happens once per app, not per frame.
+ */
+function readProcInfo(pid: number): ProcInfo | undefined {
+  try {
+    let ppid: number | undefined
+    let name: string | undefined
+    for (const line of readFileSync(`/proc/${pid}/status`, 'ascii').split('\n')) {
+      if (line.startsWith('PPid')) {
+        ppid = Number.parseInt(line.split(':')[1].trim())
+      } else if (line.startsWith('Name')) {
+        name = line.split(':')[1].trim()
+      }
+    }
+    if (ppid !== undefined) {
+      return { ppid, name: name ?? 'unknown_app' }
+    }
+  } catch {
+    // No Linux-shaped procfs. Fall through rather than throw: this runs in a
+    // native callback where a throw is unrecoverable.
+  }
+
+  try {
+    const out = execFileSync('ps', ['-o', 'ppid=,comm=', '-p', `${pid}`], {
+      encoding: 'ascii',
+      stdio: ['ignore', 'pipe', 'ignore'],
+    }).trim()
+    const match = out.match(/^(\d+)\s+(.*)$/)
+    if (match) {
+      return { ppid: Number.parseInt(match[1]), name: match[2].trim() || 'unknown_app' }
+    }
+  } catch {
+    // The process is already gone. Also possible on Linux -- a client can exit
+    // between connecting and being looked up -- so this is not only a port fix.
+  }
+
+  return undefined
+}
