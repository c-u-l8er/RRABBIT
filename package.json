{
  "name": "rrabbit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The road as a windowing system",
  "license": "AGPL-3.0",
  "scripts": {
    "m0": "vite dev",
    "proxy": "node proxy/proxy-cli.js --applications=./proxy/applications.json --allow-origin=http://127.0.0.1:8911 --bind-ip=127.0.0.1 --bind-port=8912 --base-url=ws://127.0.0.1:8912 --encoder=x264",
    "postinstall": "node tools/patch-compositor.mjs",
    "build": "node tools/patch-compositor.mjs && vite build"
  },
  "dependencies": {
    "@gfld/client-protocol": "1.0.0-rc1",
    "@gfld/common": "1.0.0-rc1",
    "@gfld/compositor": "1.0.0-rc1",
    "three": "0.160.1"
  },
  "devDependencies": {
    "@gfld/compositor-proxy-cli": "^1.0.0-rc1",
    "typescript": "^5.5.2",
    "vite": "^5.4.0"
  }
}
